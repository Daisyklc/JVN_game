# 取药的地方
# 1. 进门先检查：是不是来过？
if {visited.visited_drugstore} == true:
    # 如果来过了，直接跳转到拒绝访问的 timeline
    jump room_1F_banned/

# 2. 如果没来过，打上已访问
set {visited.visited_drugstore} = true


# 3. 开始首次进入的正式剧情【demo篇不做药房剧情】

label room_drugstore_start
label FX_blackout_start
郝悦 (P普通C制服E低沉叹气): 都没有确诊，就不拿药了吧。
label FX_blackout_end
label room_EEG_end
